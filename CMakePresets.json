{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "binaryDir": "${sourceDir}/build/dev",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FASTBDF_TESTS": "ON",
        "FASTBDF_INTEROP": "ON",
        "VCPKG_MANIFEST_FEATURES": "interop"
      }
    },
    {"name": "mne", "binaryDir": "${sourceDir}/build/mne",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "FASTBDF_MNE": "ON",
                        "Python3_ROOT_DIR": "$env{CONDA_PREFIX}"}}
  ],
  "buildPresets": [{"name": "dev", "configurePreset": "dev", "configuration": "Release"},
                   {"name": "mne", "configurePreset": "mne", "configuration": "Release"}],
  "testPresets": [
    {"name": "mne", "configurePreset": "mne", "configuration": "Release",
     "filter": {"include": {"name": "^mne_compare$"}}, "output": {"outputOnFailure": true}},
    {"name": "python-binding", "configurePreset": "mne", "configuration": "Release",
     "filter": {"include": {"name": "^python_binding$"}}, "output": {"outputOnFailure": true}},
    {"name": "mne-bench", "configurePreset": "mne", "configuration": "Release",
     "filter": {"include": {"name": "^mne_bench$"}}, "output": {"verbosity": "verbose"}},
    {"name": "dev", "configurePreset": "dev", "configuration": "Release",
     "filter": {"exclude": {"label": "benchmark"}}, "output": {"outputOnFailure": true}},
    {"name": "bench", "configurePreset": "dev", "configuration": "Release",
     "filter": {"include": {"label": "benchmark"}}, "output": {"verbosity": "verbose"}}
  ]
}
